{
  "description": "memgit: memory arrives at session start and with each prompt, and what the session learns is saved before it ends",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/memgit-hook.sh\" resume" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/memgit-hook.sh\" prompt-recall" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Grep|Glob", "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/memgit-hook.sh\" context-recall" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/memgit-hook.sh\" stop-guard" } ] }
    ]
  }
}
